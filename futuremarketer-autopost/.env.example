# 복사해서 .env 로 쓴다. .env 는 Git 과 공유 묶음에 넣지 않는다.
# 아무것도 바꾸지 않아도 기본값으로 동작한다.

# MySQL (docker-compose.yml 기본값과 맞춤)
FM_DATABASE_URL=mysql+pymysql://fm_app:fm_app_local@127.0.0.1:3317/futuremarketer?charset=utf8mb4
# 시험용 DB (pytest 가 비우고 다시 만든다. 이름이 _test 로 끝나야 한다)
FM_TEST_DATABASE_URL=mysql+pymysql://root:fm_root_local@127.0.0.1:3317/futuremarketer_test?charset=utf8mb4

# 등록 대상: real(실제 당근 비즈니스) 또는 practice(내 PC 안의 연습용 화면)
FM_DAANGN_TARGET=real

# 자동화 브라우저 창. 기본은 창이 보인다(자동화 과정을 눈으로 보기 위해).
# 1 로 두면 창 없이 조작한다(개발·시험용). 이때 당근 로그인은 할 수 없으니 연습용 화면과 함께 쓴다.
FM_BROWSER_HEADLESS=
# 창 위치와 크기: x,y,너비,높이
FM_BROWSER_WINDOW=760,60,1120,900
# Aside 실행 파일 위치(기본: /Applications/Aside.app/Contents/MacOS/Aside)
FM_ASIDE_PATH=

# AI: live(계정 설정의 연결을 사용) 또는 mock(연결 없이 예시 글·그림을 만든다)
FM_AI_MODE=live
# API 키는 여기에 적지 않는다. 계정 설정 화면에서 넣으면 프로젝트 밖 개인 폴더에 저장된다.
# 모델 이름을 바꾸고 싶을 때만
FM_CLAUDE_API_MODEL=claude-opus-5-5
FM_CLAUDE_CLI_MODEL=opus
FM_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# 기본 연결 엑셀과 이미지 폴더(비우면 samples/상품목록.xlsx, samples/images)
FM_DEFAULT_EXCEL=
FM_IMAGE_DIR=
# 로그인 정보와 API 키를 두는 개인 폴더. 비우면 사용자 폴더 아래(프로젝트 밖)
FM_PRIVATE_DIR=
# 앱 데이터(엑셀 사본·사진 사본·AI 이미지·화면 캡처·로그). 비우면 개인 폴더 아래 data
FM_DATA_DIR=
